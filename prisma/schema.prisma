generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tribo {
  id        String    @id @default(cuid())
  nome      String
  cor       String
  logo      String?
  musicas   Musica[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Musica {
  id        String    @id @default(cuid())
  nome      String
  ano       Int
  blobUrl   String
  capa      String?
  duracao   Int
  plays     Int       @default(0)
  playsWeek Int       @default(0)
  playsWeekAt DateTime @default(now())
  tribo     Tribo     @relation(fields: [triboId], references: [id])
  triboId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
